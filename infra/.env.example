# Environment template for MarketSim AI
# Copy to infra/.env and adjust.

POSTGRES_DB=marketsim
POSTGRES_USER=marketsim
POSTGRES_PASSWORD=marketsim
POSTGRES_PORT=5432

API_PORT=8080
AI_PORT=8000
WEB_PORT=5173

# Spring
JWT_SECRET=change-me-to-a-long-random-string
AI_BASE_URL=http://ai:8000
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/marketsim

# Sepolia (leave empty until contracts are deployed)
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
AUDIT_REGISTRY_ADDRESS=
